{
  "name": "@auracare/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/modules/portal && cp src/modules/portal/DejaVuSans.ttf src/modules/portal/FONT-LICENSE.txt dist/modules/portal/",
    "start": "node dist/index.js",
    "lint": "eslint src tests",
    "test": "vitest run",
    "db:indexes": "tsx src/indexes.ts",
    "db:ping": "tsx src/ping.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jose": "6.1.2",
    "mongoose": "8.24.7",
    "nodemailer": "10.2.1",
    "otpauth": "9.4.1",
    "pdfkit": "0.20.2",
    "redis": "5.10.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "vitest": "5.0.5"
  }
}
