# Never place real credentials in this file. Production requires HTTPS and SMTP.
MONGODB_URI=mongodb://127.0.0.1:27017/auracare_dev?replicaSet=rs0
APP_ORIGIN=http://localhost:5173
PORT=3000
JWT_PRIVATE_KEY_FILE=/absolute/path/to/private.pem
JWT_PUBLIC_KEY_FILE=/absolute/path/to/public.pem
MFA_ENCRYPTION_KEY_FILE=/absolute/path/to/32-byte.key
PIN_PEPPER_FILE=/absolute/path/to/separate-32-byte.key
JWT_ISSUER=auracare
JWT_AUDIENCE=auracare-tenant
# Development-only local mailbox. Never serves these files through HTTP.
MAIL_DIR=/absolute/path/to/private/mail
MAIL_FROM=no-reply@auracare.local
# Required in production; secure SMTP URL entered through secret settings.
# SMTP_URL=
# Used only by integration tests; every test run uses its own prefixed database.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Optional trusted local MongoDB executable for mongodb-memory-server tests.
# MONGOMS_SYSTEM_BINARY=/absolute/path/to/mongod

# Phase 5 private PDF storage; never serve this path through a static file server.
# DOCUMENTS_DIR=/absolute/path/to/private/persistent/documents
# FRONTEND_DIR=/absolute/path/to/built/client/dist
# Optional NONPRODUCTION local callback signing key (at least 32 random characters).
# Supply securely; never put a real value in this example or frontend.
# SANDBOX_WEBHOOK_SECRET=
# Explicit integer-paise rates; all must be present to enable a SANDBOX estimate.
# No prices or zero-cost defaults are supplied; live charges remain disabled.
# RATE_VERSION=
# RATE_SEAT_MINOR=
# RATE_SLAB_MINOR=
# RATE_GB_MINOR=
