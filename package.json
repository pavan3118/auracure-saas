{
  "name": "auracare",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build --workspaces",
    "lint": "eslint scripts e2e playwright.config.ts && npm run lint --workspaces",
    "test": "tsx scripts/local-db.ts && npm run test --workspaces",
    "db:indexes": "tsx scripts/with-env.ts db:indexes",
    "format:check": "prettier --check client/src server/src scripts e2e",
    "setup:local": "tsx scripts/setup-local.ts",
    "dev:atlas": "tsx scripts/dev.ts --atlas",
    "db:local": "tsx scripts/local-db.ts",
    "test:e2e": "playwright test",
    "check:atlas": "tsx scripts/check-atlas.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "mongoose": "8.24.7",
    "otpauth": "9.4.1",
    "prettier": "3.7.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "type": "module"
}
